# ============================================================================
# Rumah Kita — Environment Configuration Template (.env.example)
# ============================================================================
# IMPORTANT: Copy this file to `.env` for local customization.
# NEVER commit your actual `.env` file to Git. `.env` is ignored by `.gitignore`.
# ============================================================================

# Application Server Settings
PORT=3080
HOST=127.0.0.1
NODE_ENV=production

# Storage & Privacy Settings
# By default, local user data is stored in an isolated local directory (excluded from Git)
DATA_DIR=./data
ENABLE_PRIVACY_GUARD=true
ANONYMIZE_EXPORTS=true

# Default Household / Community Profile (Safe Placeholders)
HOUSEHOLD_NAME="Rumah Kita Bersama"
COMMUNITY_UNIT="RT 04 / RW 08 Nusantara"
CURRENCY="IDR"
LOCALE="id-ID"
